# ---- App ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://history:history@localhost:5432/history_learning?schema=public
# Used only by `pnpm test` (see apps/api/test/setup)
TEST_DATABASE_URL=postgresql://history:history@localhost:5432/history_learning_test?schema=public

# ---- Auth ----
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token
# Leave empty in dev. Set to your domain in production if needed.
COOKIE_DOMAIN=

# ---- Mail (dev: Mailpit) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="History Learning <no-reply@localhost>"
# Frontend URL used to build the reset-password link
APP_URL=http://localhost:3000

# ---- Media (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI (backend only, never expose to frontend) ----
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@12345
